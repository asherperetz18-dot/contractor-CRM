# Supabase project settings — Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — Console dashboard (Account SID / Auth Token) and the SMS-capable
# number under Phone Numbers -> Manage -> Active Numbers (E.164 format).
# Server-only. Never expose to the browser or commit a real value.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Twilio Voice (in-app dialer) — Account -> API keys & tokens (Standard key)
# and Voice -> TwiML Apps for the App SID. Server-only.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Resend — resend.com/api-keys for the key, and Domains for the sending
# address (must be on a domain you've verified there with SPF/DKIM/DMARC,
# or mail lands in spam). Server-only. Never expose to the browser or
# commit a real value.
RESEND_API_KEY=
EMAIL_FROM=

# Sentry — sentry.io project settings -> Client Keys (DSN). The DSN
# itself isn't secret (it can only submit events, not read them), so one
# value covers client, server, and edge -- see sentry.server.config.ts /
# sentry.edge.config.ts / src/instrumentation-client.ts. Leave blank to
# run with observability fully disabled (Sentry.init no-ops with no DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Sentry — only needed to enable source-map upload at build time
# (org/project slugs from the Sentry project URL; auth token from
# Settings -> Auth Tokens, `project:releases` scope). Server-only.
# Currently a no-op in this repo's real builds -- see next.config.ts's
# withSentryConfig comment on Turbopack.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
