# Supabase project settings — Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — Console dashboard (Account SID / Auth Token) and the SMS-capable
# number under Phone Numbers -> Manage -> Active Numbers (E.164 format).
# Server-only. Never expose to the browser or commit a real value.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
